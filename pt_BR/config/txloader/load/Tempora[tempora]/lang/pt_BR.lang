# /tempora help
tempora.command.help.description=Lists every Tempora command, or shows how to use one, e.g. /tempora help region set. A ? after any command shows the same, e.g. /tempora lookup ?
tempora.command.help.arg0=Optional. The command to explain, e.g. lookup or region set.
tempora.command.help.label.description=Description: %s
tempora.command.help.label.usage=Usage: %s
tempora.command.help.label.example=Example: %s

# /tempora lookup
tempora.command.lookup.description=Shows the latest events around you and draws them in the world. Every filter is optional and they can go in any order. By default it searches %s blocks around you, over the last %s days, in every logger, by anyone, and shows the latest %s events of each. Loggers that aren't tied to a place, such as weather, are shown by /tempora global instead.
tempora.command.lookup.arg0=How many blocks around you to search, default %s.
tempora.command.lookup.arg1=How far back to look, e.g. 30m, 6h, 1d, 2w, default 3d. A range such as 3d-1d looks between 3 days and 1 day ago.
tempora.command.lookup.arg2=Which loggers to search, comma separated, e.g. break,place. Default is every logger.
tempora.command.lookup.arg3=Whose events to show, comma separated, e.g. Player1,Player2. A ! leaves a player out instead, e.g. !Player1 for everyone but Player1. Block changes and explosions go by the closest player. Loggers with no player, such as mob spawns, are skipped. Default is anyone.
tempora.command.lookup.arg4=How many events to show from each logger, default %s, or in all with s:time, default %s. This server's limit is %s.
tempora.command.lookup.arg5=How to list the events: logger shows each logger's under its own header, time shows them all together in the order they happened, newest last. Default is logger.
tempora.command.lookup.arg6=Filters events key info by this value. Use _ instead of spaces. By default no filter is applied.
tempora.command.lookup.global_logger=%s isn't tied to a place, so it can't be looked up around you. Use %s instead.
tempora.command.lookup.name_no_answer=Your client didn't say what f:%s matches, so it can't be searched. See your client log.
tempora.command.lookup.name_empty=f:%s has nothing to search for.
tempora.command.lookup.name_too_many=f:%s is too broad and matches %s/%s things. Try a more specific search filter.

# /tempora global
tempora.command.global.description=Shows the latest events from loggers that aren't tied to a place, such as players joining and leaving, weather and TPS. Works from anywhere, including the server console. Every filter is optional and they can go in any order. By default it shows the last %s events of each, over the last %s days.
tempora.command.global.arg0=How far back to look, e.g. 30m, 6h, 1d, 2w, default 3d. A range such as 3d-1d looks between 3 days and 1 day ago.
tempora.command.global.arg1=Which loggers to show, comma separated, e.g. weather,tps. Default is every one.
tempora.command.global.arg2=How many events to show from each logger, default %s. This server's limit is %s.
tempora.command.global.positional_logger=%s records events at a place, use %s to look them up around you.

# /tempora player
tempora.command.player.description=Shows a player's latest events wherever they happened, from every logger that records players: what they broke, placed, took from or put in containers, used, picked up, dropped, the commands they ran, the mobs they killed, their deaths, achievements and movements, and when they joined and left. Block changes and explosions go by the closest player. Works from anywhere, including the server console, and draws the events in your dimension in the world. Every filter is optional and they can go in any order. By default it shows the latest %s events of each, over everything still stored.
tempora.command.player.arg0=Whose events to show, comma separated, e.g. Player1,Player2. A ! leaves a player out instead, e.g. !Player1 for everyone but Player1.
tempora.command.player.arg1=How far back to look, e.g. 30m, 6h, 1d, 2w. A range such as 3d-1d looks between 3 days and 1 day ago. Default is everything still stored.
tempora.command.player.arg2=Which loggers to search, comma separated, e.g. break,place. Default is every logger that records players.
tempora.command.player.arg3=How many events to show from each logger, default %s, or in all with s:time, default %s. This server's limit is %s.
tempora.command.player.arg4=How to list the events: logger shows each logger's under its own header, time shows them all together in the order they happened, newest last. Default is logger.
tempora.command.player.header=Latest events by %s:
tempora.command.player.no_player=%s doesn't record players. Choices are: %s.
tempora.player_filter.everyone_but=everyone but %s
tempora.player_filter.except=%s except %s

