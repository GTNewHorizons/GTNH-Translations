witchery.werewolf.mooncharmcrafted=Ses gürler: "ONU YİNE KAYBETME!"
witchery.werewolf.notworthy=Kafanın içinde bir ses yankılanıyor: "SEN BUNU HAK ETMİYORSUN!"

witchery.werewolf.level2begin=Bir ses yankılanır: "%s KÜLÇE ALTIN, ONLARI BANA VER!"
witchery.werewolf.level2progress=Derin bir ses gürler, "%s ALTIN KÜLÇESİ ARANIYOR, SENDE %s EKSİK!"
witchery.werewolf.level2complete=Ses gürleyerek konuşur: "ALTIN VERİLİR, BİR TILSIM YAPILIR, İÇİNDEKİ YARATIK SERBEST KALSIN VE AYIN ARTIK HÜKMÜ OLMASIN!"

witchery.werewolf.level3begin=Ses tonlayarak şöyle der: "PENÇELERİNİ GÜÇLENDİR, AVLARIN EN ZAYIFININ %s'İNDEN ETİNİ SIYIR, KOYUN ETLERİNİ ÖNÜME KOY!"
witchery.werewolf.level3progress=Ses yankılanıyor: "%s ÖLDÜR VE ETİNİ GETİR, %s DAHA GEREKİYOR!"
witchery.werewolf.level3complete=Ses gürlüyor: "EN ZAYIFTAN KOPARILMIŞ ET, ÇELİK GİBİ BİLENMİŞ PENÇELER, TOPRAĞI VE ETİ PARÇALAMAK İÇİN, CANAVARLARIN AÇLIĞI HİÇ DOYMAZ!" 

witchery.werewolf.level4begin=Ses gürlüyor, "ALFA'NIN DİŞLERİ BİLENMELİ, %s ALT KURTUN BOĞAZINI PARÇALA VE BANA DİLLERİNİ GETİR!"
witchery.werewolf.level4progress=Ses yankılanıyor, "%s'E HÜKMET, %s KAL!"
witchery.werewolf.level4complete=Ses gürlüyor, "SÜRÜ AÇLIK ÇEKİYOR, DİŞLER AVLA BESLENİYOR, YENİ BİR ALFA YÜKSELİYOR, ÖLDÜRÜLENDEN KARNINI DOYUR!"

witchery.werewolf.level5begin=Ses gürlüyor, "KURT İLE İNSAN BİR OLMALI, VAHŞİ AVIN BOYNUZLU EFENDİSİNİ ÖLDÜR! ONU BU BOYNUZLA ÇAĞIR VE ÖLDÜRÜCÜ DARBEYİ İNDİR!"
witchery.werewolf.level5progress=Ses yankılanıyor: "AVCI HÂLÂ YENİLMEDEN DURUYOR! ONU BOYNUZLA ÇAĞIR VE ÖLDÜRÜCÜ DARBEYİ İNDİR!"
witchery.werewolf.level5complete=Ses gürlüyor: "GÜÇLÜ BİR ŞAMPİYON YENİLDİ, MUZAFFER OLARAK DİMDİK AYAKTA DURUYOR, CANAVAR TAMAMEN UYANDI, ARTIK İKİ YA DA DÖRT BACAK ÜZERİNDE AVCILIK YAP!" 

witchery.werewolf.level6begin=Ses hırlar: "AVINI PARÇALAMAK İÇİN GÜÇLÜ KASLAR YAP, %s CANAVARA ATLA VE HAVADAN ÖLDÜR!"
witchery.werewolf.level6progress=Ses gürüldüyor, "HAVADAN %s'İ ÖLDÜRMEK EMREDİLDİ, %s KALDI!"
witchery.werewolf.level6complete=Ses ilan eder: "GÖKLERDEN ÖLÜM, ŞİMŞEK GİBİ VURURSUN, İSABET ETTİĞİNDE KOŞ, KAVGAYI HIZLA BİTİR!"

witchery.werewolf.level7begin=Ses gürlüyor: "DİĞERLERİ SENDEN KORKMAYI ÖĞRENMELİ, GECE TOPRAKLARI GEZ, %s YERLERDE GÖKYÜZÜNE BAK VE KURTLARININ SESİNİ DUYUR!"
witchery.werewolf.level7progress=Ses tonlayarak söylüyor, "%s YERDE GECE GÖĞÜNE ULU, %s KALDI!"
witchery.werewolf.level7complete=Ses hırlıyor, "SESİN DUYULDU, GELİŞİN SEVİNÇLE KARŞILANMADI, KURT ADAM HAYKIRIRKEN, DÜŞMANLARIN KORKUDAN DONUP KALSIN!"

witchery.werewolf.level8begin=Ses yankılanır: "SÜRÜYE HÜKMET! BİR KURT OLARAK %s KURT BUL VE ONLARI İRADENE BOYUN EĞDİR!"
witchery.werewolf.level8progress=Ses, "%s KURTTAN OLUŞAN BİR SÜRÜ OLUŞTUR. HENÜZ %s'TE USTALAŞMADIN!" diye mırıldanır.
witchery.werewolf.level8complete=Ses gürlüyor: "SÜRÜNÜN ALFASI, USTALIK KAZANILDI, İHTİYAÇ ANINDA HİZMETKÂRLARINI ÇAĞIRMAK İÇİN GÖĞE ULÜ."

witchery.werewolf.level9begin=Ses gürlüyor: "PENÇELER BIÇAK GİBİ, KURT ADAM OLARAK AVCILIK YAPMALISIN, NETHER'DA HORLAYAN DOMUZLARDAN %s TANESİNİ ÖLDÜR!"
witchery.werewolf.level9progress=Ses şöyle seslenir: "KURT ADAM OLARAK %s CEHENNEM DOMUZU AVLA, %s BULUNMALI!"
witchery.werewolf.level9complete=Ses ilan eder: "CEHENNEMİ DÜŞMANLAR YENİLDİ, PENÇELER BİLENDİ, ZIRHLAR KÂĞIT GİBİ, ŞİMDİ PARAMPARÇA EDİLECEKSİNİZ!"

witchery.werewolf.level10begin=Ses gürlüyor: "KÖYDEN YA DA BİR DOSTTAN BAŞKA BİRİNİN HAYATINI AL, SONRA SANA LÜTUF OLARAK, YAYMAN İÇİN KUTSAM VERİLECEK!"
witchery.werewolf.level10progress=Ses yankılanıyor: "KÖYDEN BİRİNİ ÖLDÜR, YA DA SENİN GİBİ BİRİNİ!"
witchery.werewolf.level10complete=Ses haykırıyor: "YOLUMDA USTALAŞTIN, ŞİMDİ KUTSAMAMI YAY!"

