salisarcana:command.create-node.args.modifier=§7§o[-m <modifier>]§r Yeni düğümün yükseltmesini belirt
salisarcana:command.create-node.args.silverwood=§7§o[--silverwood]§r Gümüş ağaçta oluşmuş gibi saf ve küçük bir düğüm oluşturur. §7--eerie§r ve §7--small§r ile birlikte kullanılamaz.
salisarcana:command.create-node.args.eerie=§7§o[--eerie]§r Obsidyen totemde oluşmuş gibi koyu bir düğüm oluşturur. §7--silverwood§r ile birlikte kullanılamaz.
salisarcana:command.create-node.args.small=§7§o[--small]§r Düğümün aspekt kapasitesi düşük olur. §7--silverwood§r ve §7-a§r ile birlikte kullanılamaz.
salisarcana:command.create-node.args.aspect=§7§o[-a <aspect> <count>]§r Yeni düğümün aspektlerini geçersiz kılar. Ek aspekt belirtmek için birden çok kez kullanılabilir. §7--small§r ile birlikte kullanılamaz.

salisarcana:command.create-node.failure=%d %d %d konumunda bir düğüm oluşturulamadı.

salisarcana:command.forget-research.desc=Bir oyuncunun bilgisinden araştırma kaldır.
salisarcana:command.forget-research.usage=§7/salisarcana-forget-research §7<--all §7§lVEYA§r §7--research-key §7<key>[ §7--research-key §7<key2> §7...]> §7[--player §7<username>] §7[--scalpel]§r
salisarcana:command.forget-research.args.all=§7<--all>§r Oyuncunun bildiği tüm araştırmaları kaldırır. §7research-key§r verilmezse zorunludur. §7research-key§r ve §7scalpel§r ile birlikte kullanılamaz.
salisarcana:command.forget-research.args.research=§7<--research-key>§r Kaldırılacak araştırmanın kimliğini belirtir. Birden çok kez verilebilir. §7all§r ayarlanmamışsa zorunludur. §7all§r ile birlikte kullanılamaz.
salisarcana:command.forget-research.args.player=§7[--player <username>]§r Araştırması değiştirilecek oyuncuyu belirtir. Verilmezse bu komutu yürüten oyuncu varsayılır.
salisarcana:command.forget-research.args.scalpel=§7[--scalpel]§r Ayarlanırsa belirtilen araştırma kaldırılır; ancak kardeşlerinden veya alt dallarından hiçbiri kaldırılmaz. Bu beklenmeyen yan etkilere yol açabilir. §7all§r ile aynı anda kullanılamaz.
salisarcana:command.forget-research.args.retain-warp=§7[--retain-warp]§r Ayarlandığında, kaldırılan araştırmayla ilişkili kalıcı ve/veya yapışkan Delilik korunur.

salisarcana:command.forget-research.remove=§9Başarılı:§r %d araştırma öğesi ve ilişkili Delilik kaldırıldı; toplamda %d kalıcı Delilik ve %d yapışkan Delilik silindi.
salisarcana:command.forget-research.retain=§9Başarılı:§r %d araştırma öğesi kaldırıldı. (%d kalıcı Delilik ve %d yapışkan Delilik §lkaldırılmadı§r.)

