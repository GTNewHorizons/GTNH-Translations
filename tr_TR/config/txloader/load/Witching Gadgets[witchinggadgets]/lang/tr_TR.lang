witchinggadgets_research_text.GEMCUT_STEP=[WG] Şıng!
witchinggadgets_research_page.GEMCUT_STEP.1=<IMG>witchinggadgets:textures/gui/research/gemcuts.png:160:0:80:80:1</IMG>Masa kesimi şudur
