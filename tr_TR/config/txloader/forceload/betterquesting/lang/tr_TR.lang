betterquesting.quest.AAAAAAAAAAAAAAAAAAABNw.desc=Asla kırılmaz. Ne kadar kullanışlı.

# Quest: Unleashed the Power - Leggings
betterquesting.quest.AAAAAAAAAAAAAAAAAAABOA.name=Gücü Serbest Bırak - Tozluk
